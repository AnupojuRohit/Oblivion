# Required in deployed environments. MongoDB-dependent features validate this at runtime.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/learnhub
SESSION_SECRET=replace-with-a-long-random-secret
REDIS_URL=
REDIS_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated LAN IPs/hostnames for Next.js dev HMR when not using localhost (optional)
ALLOWED_DEV_ORIGINS=
